    .chip-text { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 11px; font-weight: 700; }
    .date-text { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 12px; font-weight: 500; fill: #6e7781; }

    @media (prefers-color-scheme: dark) {
      .card-bg { stroke: #30363d; }
      .cap-icon { stroke: #93c5fd; }
      .title { fill: #e6edf3; }
      .pill { stroke: #8b949e; }
      .pill-text { fill: #8b949e; }
      .sub { fill: #8b949e; }
      .desc { fill: #8b949e; }
